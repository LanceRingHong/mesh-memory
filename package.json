{
  "name": "dsh-mesh",
  "version": "0.7.0",
  "private": true,
  "description": "DSH Mesh: shared memory (AGENTS/skills/summaries) and cross-device DSH delegation over DSH Remote.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "syncthing",
    "remote",
    "markdown"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check src/config.js && node --check src/store.js && node --check src/agents.js && node --check src/remote.js && node --check src/tools.js && node --check src/dashboard.js && node --check src/native.js && node --check src/recall.js && node --check src/policy.js && node --check src/capture.js && node --check src/inbox.js && node --check src/backup.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "LanceRingHong",
  "repository": {
    "type": "git",
    "url": "https://github.com/LanceRingHong/dsh-mesh.git"
  },
  "homepage": "https://github.com/LanceRingHong/dsh-mesh#readme",
  "bugs": {
    "url": "https://github.com/LanceRingHong/dsh-mesh/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "记忆",
      "en": "Memory"
    },
    "icon": "book",
    "contributes": {
      "composer.strip": [
        {
          "id": "memory-strip",
          "icon": "book",
          "text": "记忆",
          "panel": "memory"
        }
      ],
      "panels": [
        {
          "id": "memory",
          "title": {
            "zh": "记忆",
            "en": "Memory"
          },
          "icon": "book",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
